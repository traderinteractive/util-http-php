{
    "name": "traderinteractive/util-http",
    "description": "A collection of http classes.",
    "keywords": ["utility", "http"],
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^7.3 || ^8.0"
    },
    "require-dev": {
